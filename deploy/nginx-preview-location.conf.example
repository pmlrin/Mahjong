# Insert inside the existing mahjong.yangjm.cn HTTPS server after taking a backup.
# Validate nginx -t before reload. The production / route keeps its upstream.
location = /preview { return 308 /preview/$is_args$args; }
# The server block caps bodies at 32k; avatar uploads need up to 300 KB.
location = /preview/api/v2/profile/avatar {
    client_max_body_size 320k;
    proxy_pass http://127.0.0.1:18031/api/v2/profile/avatar;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 75s;
}
location ^~ /preview/ {
    proxy_pass http://127.0.0.1:18031/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 75s;
    proxy_buffering off;
}
