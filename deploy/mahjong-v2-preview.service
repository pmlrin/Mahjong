[Unit]
Description=Mahjong V2 isolated preview
After=network.target docker.service
[Service]
Type=simple
User=mahjong
Group=mahjong
WorkingDirectory=/opt/mahjong/releases/20261029-v2-rc3
EnvironmentFile=/opt/mahjong/v2-preview.env
ExecStart=/opt/mahjong/runtime/bin/node dist-server/backend/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mahjong/releases/20261029-v2-rc3
[Install]
WantedBy=multi-user.target
