[Unit]
Description=Ichitaku Mahjong
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=simple
User=mahjong
Group=mahjong
WorkingDirectory=/opt/mahjong/current
EnvironmentFile=/opt/mahjong/service.env
ExecStart=/opt/mahjong/runtime/bin/node dist-server/backend/src/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=384M
TasksMax=64
[Install]
WantedBy=multi-user.target
