# Local development: omit DATABASE_URL to use data/mahjong.sqlite.
HOST=127.0.0.1
PORT=3000
# Production requires PostgreSQL, HTTPS origin and a random 32+ character secret.
# DATABASE_URL=postgres://mahjong:CHANGE_ME@127.0.0.1:5432/mahjong
# PUBLIC_ORIGIN=https://mahjong.yangjm.cn
# SESSION_SECRET=GENERATE_A_RANDOM_SECRET

# Optional isolated preview (production defaults need no change)
# SESSION_COOKIE_NAME=mj_preview_session
# SESSION_COOKIE_PATH=/preview
# STATIC_DIR=/absolute/path/to/preview/dist
# MAINTENANCE_FILE=/opt/mahjong/maintenance
# PERF_METRICS=1
