# V4 has no additional credentials or external services.
PROFILE_EDITING_ENABLED=true
SESSION_MANAGEMENT_ENABLED=true
FRIENDS_ENABLED=true
FRIEND_INVITATIONS_ENABLED=true
SOCIAL_PUSH_ENABLED=true
# Optional lower limits; defaults remain the specification's hard ceilings.
SOCIAL_LIMIT_FRIENDS=200
SOCIAL_LIMIT_PENDING_REQUESTS=50
SOCIAL_LIMIT_PENDING_INVITATIONS=20
SOCIAL_LIMIT_BLOCKS=500
SOCIAL_LIMIT_PROFILE_WRITES=10
SOCIAL_LIMIT_LOOKUP_MINUTE=20
SOCIAL_LIMIT_LOOKUP_DAY=200
SOCIAL_LIMIT_LOOKUP_IP_MINUTE=100
SOCIAL_LIMIT_REQUEST_HOUR=10
SOCIAL_LIMIT_REQUEST_DAY=30
SOCIAL_LIMIT_INVITE_HOUR=30
SOCIAL_LIMIT_STATE_MINUTE=60
SOCIAL_LIMIT_PASSWORD_ACCOUNT=5
SOCIAL_LIMIT_PASSWORD_IP=20
SOCIAL_CLEANUP_BATCH=100
