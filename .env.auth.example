# Copy via pnpm auth:configure; actual .env.auth.local is ignored by Git.
# Run with Node >=24.7, recommended current project Node 24.22+.
AUTH_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
MAIL_ENVIRONMENT=preview
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@notify.yangjm.cn
SMTP_PASSWORD=
MAIL_FROM_NAME=一桌麻将
MAIL_FROM_ADDRESS=noreply@notify.yangjm.cn
# Full previously confirmed test mailbox goes only into restricted configuration.
MAIL_TEST_ALLOWLIST=
# Generated independently by auth:configure. Do not reuse SESSION_SECRET.
OTP_HMAC_SECRET=
MAIL_OUTBOX_ENCRYPTION_KEY=
MAIL_DAILY_ATTEMPT_LIMIT=100
# Shared between preview/production when they use the same SMTP sender.
MAIL_PROVIDER_DAILY_ATTEMPT_LIMIT=100
# Server: /opt/mahjong/mail-budget/provider.sqlite (service user must own the directory).
MAIL_SHARED_BUDGET_PATH=
